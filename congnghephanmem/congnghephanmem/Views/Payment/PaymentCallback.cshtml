@{
    ViewBag.Title = "Kết quả thanh toán";
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
}

<div class="container py-5 text-center">
    @if (ViewBag.Message.Contains("thành công"))
    {
        <i class="fas fa-check-circle text-success" style="font-size: 5rem;"></i>
        <h2 class="mt-3 text-success">Thanh toán thành công!</h2>
    }
    else
    {
        <i class="fas fa-times-circle text-danger" style="font-size: 5rem;"></i>
        <h2 class="mt-3 text-danger">Thanh toán thất bại</h2>
    }

    <p class="lead">@ViewBag.Message</p>
    <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3">Về trang chủ</a>
</div>