@model congnghephanmem.ViewModels.UserProfileViewModel

@{
    ViewBag.Title = "Hồ sơ cá nhân";
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
}

<style>
    .profile-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
        border: 1px solid #f1f5f9;
        overflow: hidden;
    }

    .profile-nav .nav-link {
        color: #64748b;
        font-weight: 500;
        padding: 12px 20px;
        border-radius: 8px;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 5px;
    }

        .profile-nav .nav-link:hover, .profile-nav .nav-link.active {
            background-color: rgba(19, 236, 200, 0.1);
            color: var(--primary-color, #13ecc8);
        }

    .avatar-wrapper {
        position: relative;
        width: 120px;
        height: 120px;
        margin: 0 auto 20px;
    }

    .avatar-img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #fff;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .upload-btn {
        position: absolute;
        bottom: 5px;
        right: 5px;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--primary-color, #13ecc8);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border: 2px solid white;
    }
</style>

<div class="container py-5">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="material-symbols-outlined align-middle me-2">check_circle</i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-3">
            <div class="profile-card p-4 h-100">
                <div class="text-center mb-4">
                    <img src="@Model.CurrentAvatar" class="rounded-circle mb-3" style="width: 80px; height: 80px; object-fit: cover;">
                    <h6 class="fw-bold text-dark m-0">@Model.FullName</h6>
                    <p class="text-muted small">@Model.Email</p>
                </div>
                <div class="nav flex-column profile-nav">
                    <a href="@Url.Action("Profile", "Account")" class="nav-link active">
                        <span class="material-symbols-outlined fs-5">person</span> Thông tin tài khoản
                    </a>
                    <a href="@Url.Action("Index", "Address")" class="nav-link">
                        <span class="material-symbols-outlined fs-5">location_on</span> Sổ địa chỉ
                    </a>
                    <a href="@Url.Action("History", "Order")" class="nav-link">
                        <span class="material-symbols-outlined fs-5">shopping_bag</span> Lịch sử đơn hàng
                    </a>
                    <a href="@Url.Action("ChangePassword", "Account")" class="nav-link">
                        <span class="material-symbols-outlined fs-5">lock</span> Đổi mật khẩu
                    </a>
                    <a href="@Url.Action("Logout", "Account")" class="nav-link text-danger mt-3">
                        <span class="material-symbols-outlined fs-5">logout</span> Đăng xuất
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="profile-card p-4 p-md-5">
                <h4 class="fw-bold text-dark mb-4">Cập nhật thông tin</h4>

                @using (Html.BeginForm("UpdateProfile", "Account", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.Id)
                    @Html.HiddenFor(m => m.Email)
                    @Html.HiddenFor(m => m.CurrentAvatar)

                    <div class="text-center mb-5">
                        <div class="avatar-wrapper">
                            <img id="previewImg" src="@Model.CurrentAvatar" class="avatar-img" />
                            <label for="AvatarFile" class="upload-btn hover-scale">
                                <span class="material-symbols-outlined fs-6">photo_camera</span>
                            </label>
                            <input type="file" id="AvatarFile" name="AvatarFile" class="d-none" accept="image/*" onchange="previewImage(this)">
                        </div>
                        <small class="text-muted">Nhấn vào icon máy ảnh để thay đổi ảnh đại diện</small>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">Họ và tên</label>
                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Nhập họ tên của bạn" })
                            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">Số điện thoại</label>
                            @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "Nhập số điện thoại" })
                            @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted">Email (Không thể thay đổi)</label>
                            <input type="text" class="form-control bg-light" value="@Model.Email" readonly disabled />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted">Địa chỉ mặc định</label>
                            @Html.TextAreaFor(m => m.Address, new { @class = "form-control", rows = "2", placeholder = "Nhập địa chỉ giao hàng mặc định..." })
                        </div>
                    </div>

                    <div class="mt-5 text-end">
                        <button type="submit" class="btn btn-primary-custom px-5 py-3 rounded-3 fw-bold shadow-sm">
                            Lưu thay đổi
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    function previewImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('previewImg').src = e.target.result;
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>