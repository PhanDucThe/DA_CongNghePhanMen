@model congnghephanmem.Models.LoginViewModel

@{
    Layout = null; 
}

<!DOCTYPE html>
<html class="light" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Đăng nhập - Nhà Thuốc Online</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#13ecc8",
                        "background-light": "#f6f8f8",
                        "background-dark": "#10221f",
                        "text-light": "#0d1b19",
                        "text-dark": "#e0f2ef",
                        "subtle-light": "#e7f3f1",
                        "subtle-dark": "#1a3833",
                        "border-light": "#cfe7e3",
                        "border-dark": "#2a5f56",
                        "placeholder-light": "#4c9a8d",
                        "placeholder-dark": "#85b3ac"
                    },
                    fontFamily: {
                        "display": ["Manrope", "sans-serif"]
                    },
                },
            },
        }
    </script>
</head>
<body class="font-display bg-background-light dark:bg-background-dark">
    <div class="relative flex min-h-screen w-full flex-col group/design-root overflow-x-hidden">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mx-4 mt-4" role="alert">
                <strong class="font-bold">Thành công!</strong>
                <span class="block sm:inline">@TempData["SuccessMessage"]</span>
            </div>
        }

        <div class="flex-grow flex items-stretch">
            <div class="grid w-full grid-cols-1 md:grid-cols-2">

                <div class="relative hidden h-full flex-col items-center justify-center bg-subtle-light p-10 dark:bg-subtle-dark md:flex">
                    <div class="absolute inset-0 bg-center bg-no-repeat bg-cover"
                         style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAORMNq2xqQjjP4eF4n8S5feiE4f2vudsEXjyVnFLmxOTxuIwXR6nADWrE_nAzCimHMB0tGfhjcLivKv-4QRyCRJVKPDWmN860m21p0L57TdIfDwAgcs7p_r-Q9XbkOqWa-NBP2xeNw6USY_SJXPsXclZI8Y4z9at5vIt7v4soBiqPll5MJyOhFwTJmx2SnBQ3UnCA8HrutYSxFnsUfAsTYerYvEjutWlIo-4dd-EWBDD7utMnkj6PYFu4YM9qkG1xS3q1r0XVRkzo'); opacity: 0.1;">
                    </div>
                    <div class="relative z-10 w-full max-w-md text-center">
                        <img alt="Illustration" class="mx-auto mb-8 w-full max-w-sm" src="https://lh3.googleusercontent.com/aida-public/AB6AXuC9Wr_DEK7W7M2KYZ0-u-DUse3FX5YqTmMEQp_8g5QvVLHN6NikU2nsaYOerywXATt3I8fibxZOqFILDHJuGtqdiuvQC_MzXKPyyfVE4TMHD460-qZHHJZzKk10rioXIlYiK4QeL7Es61qblBbuJB_TGCpWn-FrI5iW9elxV6G_5hlnbXwywvrSDyiPDwAbv4YDxm0R0PrUBmAJUSrAfw-c6ZzzHEgr2XL_ibvI57zt8C2fMvEppwS3yNiGb1yUf04WKCGCscJuneY" />
                        <h1 class="text-4xl font-black leading-tight tracking-tight text-text-light dark:text-text-dark">Sức Khỏe Của Bạn Là Ưu Tiên Của Chúng Tôi</h1>
                    </div>
                </div>

                <div class="flex w-full items-center justify-center bg-background-light p-6 dark:bg-background-dark sm:p-8 lg:p-12">
                    <div class="w-full max-w-md">
                        <div class="mb-8 text-left">
                            <h1 class="text-text-light dark:text-text-dark text-4xl font-black leading-tight tracking-[-0.033em] sm:text-5xl">Đăng nhập</h1>
                            <h2 class="text-placeholder-light dark:text-placeholder-dark text-base font-normal leading-normal mt-2">Chào mừng trở lại! Vui lòng nhập thông tin.</h2>
                        </div>

                        @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "flex flex-col gap-6" }))
                        {
                            @Html.AntiForgeryToken()

                            @Html.ValidationSummary(true, "", new { @class = "text-red-500 text-sm font-bold mb-2" })

                            <div class="flex flex-col w-full">
                                <label class="text-text-light dark:text-text-dark text-base font-medium leading-normal pb-2" for="Username">Email hoặc SĐT</label>
                                <div class="flex w-full flex-1 items-stretch rounded-lg">
                                    <div class="text-placeholder-light dark:text-placeholder-dark flex items-center justify-center rounded-l-lg border border-r-0 border-border-light bg-subtle-light p-3 dark:border-border-dark dark:bg-subtle-dark">
                                        <span class="material-symbols-outlined" style="font-size: 24px;">person</span>
                                    </div>
                                    @Html.TextBoxFor(m => m.Username, new
                                    {
                                        @class = "form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-r-lg text-text-light dark:text-text-dark focus:outline-0 focus:ring-2 focus:ring-primary/50 border border-border-light bg-background-light dark:border-border-dark dark:bg-background-dark h-14 placeholder:text-placeholder-light dark:placeholder:text-placeholder-dark p-[15px] text-base font-normal leading-normal",
                                        placeholder = "Nhập email hoặc số điện thoại"
                                    })
                                </div>
                                @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-red-500 text-xs mt-1" })
                            </div>

                            <label class="flex flex-col min-w-40 flex-1">
                                <p class="text-text-light dark:text-text-dark text-base font-medium leading-normal pb-2">Mật khẩu</p>
                                <div class="flex w-full flex-1 items-stretch rounded-lg">
                                    <div class="text-placeholder-light dark:text-placeholder-dark flex items-center justify-center rounded-l-lg border border-r-0 border-border-light bg-subtle-light p-3 dark:border-border-dark dark:bg-subtle-dark">
                                        <span class="material-symbols-outlined" style="font-size: 24px;">lock</span>
                                    </div>
                                    @Html.PasswordFor(m => m.Password, new
                                    {
                                        @class = "form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden text-text-light dark:text-text-dark focus:outline-0 focus:ring-2 focus:ring-primary/50 border border-border-light bg-background-light dark:border-border-dark dark:bg-background-dark h-14 placeholder:text-placeholder-light dark:placeholder:text-placeholder-dark p-[15px] rounded-r-none border-r-0 pr-2 text-base font-normal leading-normal",
                                        placeholder = "Nhập mật khẩu"
                                    })
                                    <div class="text-placeholder-light dark:text-placeholder-dark flex border border-border-light bg-background-light dark:border-border-dark dark:bg-background-dark items-center justify-center pr-[15px] rounded-r-lg border-l-0 cursor-pointer">
                                        <span class="material-symbols-outlined" style="font-size: 24px;">visibility</span>
                                    </div>
                                </div>
                                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-red-500 text-xs mt-1" })
                            </label>

                            <a href="@Url.Action("ForgotPassword", "Account")" class="text-placeholder-light dark:text-placeholder-dark text-sm font-normal leading-normal self-end underline cursor-pointer hover:text-primary transition-colors">Quên mật khẩu?</a>

                            <button class="flex min-w-[84px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-12 px-5 flex-1 bg-primary text-text-light text-base font-bold leading-normal tracking-[0.015em] hover:bg-opacity-90 transition-opacity" type="submit">
                                <span class="truncate">Đăng nhập</span>
                            </button>
                        }
                        <div class="relative flex items-center py-6">
                            <div class="flex-grow border-t border-border-light dark:border-border-dark"></div>
                            <span class="mx-4 flex-shrink text-sm text-placeholder-light dark:text-placeholder-dark">hoặc</span>
                            <div class="flex-grow border-t border-border-light dark:border-border-dark"></div>
                        </div>

                        <div class="flex flex-col gap-4 sm:flex-row">
                            <button class="flex h-12 w-full items-center justify-center gap-3 rounded-lg border border-border-light bg-background-light px-4 text-sm font-medium text-text-light hover:bg-subtle-light dark:border-border-dark dark:bg-background-dark dark:text-text-dark dark:hover:bg-subtle-dark transition-colors">
                                <img src="https://www.svgrepo.com/show/475656/google-color.svg" class="w-5 h-5" alt="Google">
                                <span>Google</span>
                            </button>
                            <button class="flex h-12 w-full items-center justify-center gap-3 rounded-lg border border-border-light bg-background-light px-4 text-sm font-medium text-text-light hover:bg-subtle-light dark:border-border-dark dark:bg-background-dark dark:text-text-dark dark:hover:bg-subtle-dark transition-colors">
                                <img src="https://www.svgrepo.com/show/475647/facebook-color.svg" class="w-5 h-5" alt="Facebook">
                                <span>Facebook</span>
                            </button>
                        </div>

                        <p class="text-placeholder-light dark:text-placeholder-dark text-sm font-normal leading-normal text-center pt-6">
                            Chưa có tài khoản? <a class="font-bold text-primary hover:underline" href="@Url.Action("Register", "Account")">Đăng ký ngay</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>