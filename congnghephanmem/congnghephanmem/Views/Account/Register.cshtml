@model congnghephanmem.Models.RegisterViewModel

@{
    Layout = null; 
}

<!DOCTYPE html>
<html class="light" lang="vi">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Đăng ký tài khoản - Nhà Thuốc Online</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#13ecc8",
                        "background-light": "#f6f8f8",
                        "background-dark": "#10221f",
                        "text-light": "#0d1b19",
                        "text-dark": "#e0f2ef",
                        "subtle-light": "#e7f3f1",
                        "subtle-dark": "#1a3833",
                        "border-light": "#cfe7e3",
                        "border-dark": "#2a5f56",
                        "placeholder-light": "#4c9a8d",
                        "placeholder-dark": "#85b3ac"
                    },
                    fontFamily: {
                        "display": ["Manrope", "sans-serif"]
                    },
                },
            },
        }
    </script>
</head>
<body class="font-display bg-background-light dark:bg-background-dark">
    <div class="relative flex min-h-screen w-full flex-col group/design-root overflow-x-hidden">
        <div class="flex-grow flex items-stretch">
            <div class="grid w-full grid-cols-1 md:grid-cols-2">

                <div class="relative hidden h-full flex-col items-center justify-center bg-subtle-light p-10 dark:bg-subtle-dark md:flex sticky top-0">
                    <div class="absolute inset-0 bg-center bg-no-repeat bg-cover"
                         style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAORMNq2xqQjjP4eF4n8S5feiE4f2vudsEXjyVnFLmxOTxuIwXR6nADWrE_nAzCimHMB0tGfhjcLivKv-4QRyCRJVKPDWmN860m21p0L57TdIfDwAgcs7p_r-Q9XbkOqWa-NBP2xeNw6USY_SJXPsXclZI8Y4z9at5vIt7v4soBiqPll5MJyOhFwTJmx2SnBQ3UnCA8HrutYSxFnsUfAsTYerYvEjutWlIo-4dd-EWBDD7utMnkj6PYFu4YM9qkG1xS3q1r0XVRkzo'); opacity: 0.1;">
                    </div>

                    <div class="relative z-10 w-full max-w-md text-center">
                        <img alt="Illustration of a pharmacist"
                             class="mx-auto mb-8 w-full max-w-sm"
                             src="https://lh3.googleusercontent.com/aida-public/AB6AXuC9Wr_DEK7W7M2KYZ0-u-DUse3FX5YqTmMEQp_8g5QvVLHN6NikU2nsaYOerywXATt3I8fibxZOqFILDHJuGtqdiuvQC_MzXKPyyfVE4TMHD460-qZHHJZzKk10rioXIlYiK4QeL7Es61qblBbuJB_TGCpWn-FrI5iW9elxV6G_5hlnbXwywvrSDyiPDwAbv4YDxm0R0PrUBmAJUSrAfw-c6ZzzHEgr2XL_ibvI57zt8C2fMvEppwS3yNiGb1yUf04WKCGCscJuneY" />

                        <h1 class="text-4xl font-black leading-tight tracking-tight text-text-light dark:text-text-dark">
                            Tham Gia Cộng Đồng Sống Khỏe Của Chúng Tôi
                        </h1>
                    </div>
                </div>

                <div class="flex w-full items-center justify-center bg-background-light p-6 dark:bg-background-dark sm:p-8 lg:p-12">
                    <div class="w-full max-w-md">
                        <div class="mb-6 text-left">
                            <h1 class="text-text-light dark:text-text-dark text-4xl font-black leading-tight tracking-[-0.033em] sm:text-5xl">Đăng ký</h1>
                            <h2 class="text-placeholder-light dark:text-placeholder-dark text-base font-normal leading-normal mt-2">Điền thông tin để bắt đầu hành trình sức khỏe.</h2>
                        </div>

                        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "flex flex-col gap-5" }))
                        {
                            @Html.AntiForgeryToken()

                            @Html.ValidationSummary(true, "", new { @class = "text-red-500 font-bold text-sm mb-2" })

                            <div class="flex flex-col w-full">
                                <label class="text-text-light dark:text-text-dark text-base font-medium leading-normal pb-2">Họ và tên</label>
                                <div class="flex w-full flex-1 items-stretch rounded-lg">
                                    <div class="text-placeholder-light dark:text-placeholder-dark flex items-center justify-center rounded-l-lg border border-r-0 border-border-light bg-subtle-light p-3 dark:border-border-dark dark:bg-subtle-dark">
                                        <span class="material-symbols-outlined">badge</span>
                                    </div>
                                    @Html.TextBoxFor(m => m.FullName, new
                                    {
                                        @class = "form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-r-lg text-text-light dark:text-text-dark focus:outline-0 focus:ring-2 focus:ring-primary/50 border border-border-light bg-background-light dark:border-border-dark dark:bg-background-dark h-14 placeholder:text-placeholder-light dark:placeholder:text-placeholder-dark p-[15px] text-base font-normal leading-normal",
                                        placeholder = "Nguyễn Văn A"
                                    })
                                </div>
                                @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-red-500 text-xs mt-1" })
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label class="text-text-light dark:text-text-dark text-base font-medium leading-normal pb-2">Số điện thoại</label>
                                    <div class="flex w-full flex-1 items-stretch rounded-lg">
                                        <div class="text-placeholder-light dark:text-placeholder-dark flex items-center justify-center rounded-l-lg border border-r-0 border-border-light bg-subtle-light p-3 dark:border-border-dark dark:bg-subtle-dark">
                                            <span class="material-symbols-outlined">call</span>
                                        </div>
                                        @Html.TextBoxFor(m => m.PhoneNumber, new
                                        {
                                            @class = "form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-r-lg text-text-light dark:text-text-dark focus:outline-0 focus:ring-2 focus:ring-primary/50 border border-border-light bg-background-light dark:border-border-dark dark:bg-background-dark h-14 placeholder:text-placeholder-light dark:placeholder:text-placeholder-dark p-[15px] text-base font-normal leading-normal",
                                            placeholder = "09xxx"
                                        })
                                    </div>
                                    @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-red-500 text-xs mt-1" })
                                </div>

                                <div>
                                    <label class="text-text-light dark:text-text-dark text-base font-medium leading-normal pb-2">Email</label>
                                    <div class="flex w-full flex-1 items-stretch rounded-lg">
                                        <div class="text-placeholder-light dark:text-placeholder-dark flex items-center justify-center rounded-l-lg border border-r-0 border-border-light bg-subtle-light p-3 dark:border-border-dark dark:bg-subtle-dark">
                                            <span class="material-symbols-outlined">mail</span>
                                        </div>
                                        @Html.TextBoxFor(m => m.Email, new
                                        {
                                            @class = "form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-r-lg text-text-light dark:text-text-dark focus:outline-0 focus:ring-2 focus:ring-primary/50 border border-border-light bg-background-light dark:border-border-dark dark:bg-background-dark h-14 placeholder:text-placeholder-light dark:placeholder:text-placeholder-dark p-[15px] text-base font-normal leading-normal",
                                            placeholder = "abc@mail.com"
                                        })
                                    </div>
                                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-red-500 text-xs mt-1" })
                                </div>
                            </div>

                            <div class="flex flex-col w-full">
                                <label class="text-text-light dark:text-text-dark text-base font-medium leading-normal pb-2">Mật khẩu</label>
                                <div class="flex w-full flex-1 items-stretch rounded-lg">
                                    <div class="text-placeholder-light dark:text-placeholder-dark flex items-center justify-center rounded-l-lg border border-r-0 border-border-light bg-subtle-light p-3 dark:border-border-dark dark:bg-subtle-dark">
                                        <span class="material-symbols-outlined">lock</span>
                                    </div>
                                    @Html.PasswordFor(m => m.Password, new
                                    {
                                        @class = "form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-r-lg text-text-light dark:text-text-dark focus:outline-0 focus:ring-2 focus:ring-primary/50 border border-border-light bg-background-light dark:border-border-dark dark:bg-background-dark h-14 placeholder:text-placeholder-light dark:placeholder:text-placeholder-dark p-[15px] text-base font-normal leading-normal",
                                        placeholder = "Tối thiểu 6 ký tự"
                                    })
                                </div>
                                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-red-500 text-xs mt-1" })
                            </div>

                            <div class="flex flex-col w-full">
                                <label class="text-text-light dark:text-text-dark text-base font-medium leading-normal pb-2">Xác nhận mật khẩu</label>
                                <div class="flex w-full flex-1 items-stretch rounded-lg">
                                    <div class="text-placeholder-light dark:text-placeholder-dark flex items-center justify-center rounded-l-lg border border-r-0 border-border-light bg-subtle-light p-3 dark:border-border-dark dark:bg-subtle-dark">
                                        <span class="material-symbols-outlined">verified_user</span>
                                    </div>
                                    @Html.PasswordFor(m => m.ConfirmPassword, new
                                    {
                                        @class = "form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-r-lg text-text-light dark:text-text-dark focus:outline-0 focus:ring-2 focus:ring-primary/50 border border-border-light bg-background-light dark:border-border-dark dark:bg-background-dark h-14 placeholder:text-placeholder-light dark:placeholder:text-placeholder-dark p-[15px] text-base font-normal leading-normal",
                                        placeholder = "Nhập lại mật khẩu"
                                    })
                                </div>
                                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-red-500 text-xs mt-1" })
                            </div>

                            <button class="mt-2 flex min-w-[84px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-12 px-5 flex-1 bg-primary text-text-light text-base font-bold leading-normal tracking-[0.015em] hover:bg-opacity-90 transition-opacity shadow-sm" type="submit">
                                <span class="truncate">ĐĂNG KÝ TÀI KHOẢN</span>
                            </button>
                        }

                        <p class="text-placeholder-light dark:text-placeholder-dark text-sm font-normal text-center pt-6">
                            Đã có tài khoản? <a class="font-bold text-primary hover:underline" href="@Url.Action("Login", "Account")">Đăng nhập ngay</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>