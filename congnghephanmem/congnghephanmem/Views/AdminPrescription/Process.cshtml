@model congnghephanmem.Models.prescription
@{
    ViewBag.Title = "Xử lý đơn thuốc";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-bold">Hình ảnh đơn thuốc</div>
            <div class="card-body text-center bg-light">
                <img src="@Model.image_url" class="img-fluid rounded shadow-sm" style="max-height: 600px;" />
                <div class="mt-3">
                    <a href="@Model.image_url" target="_blank" class="btn btn-sm btn-outline-primary">
                        <i class="material-symbols-outlined align-middle">zoom_in</i> Xem ảnh gốc
                    </a>
                </div>
            </div>
            <div class="card-footer">
                <small class="text-muted">Ghi chú của khách:</small>
                <p class="fw-bold">@Model.note</p>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-bold bg-white">Tư vấn & Phản hồi</div>
            <div class="card-body">
                <form action="@Url.Action("SubmitProcess")" method="post">
                    <input type="hidden" name="id" value="@Model.id" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Nội dung tư vấn / Lý do từ chối</label>
                        <textarea name="response" class="form-control" rows="8" placeholder="Nhập danh sách thuốc có sẵn hoặc lý do từ chối... Ví dụ: Thuốc A (Link), Thuốc B (Link)"></textarea>
                        <small class="text-muted">Có thể dán link sản phẩm để khách mua ngay.</small>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" name="status" value="APPROVED" class="btn btn-success fw-bold py-2">
                            <i class="material-symbols-outlined align-middle">check</i> DUYỆT & GỬI TƯ VẤN
                        </button>
                        <button type="submit" name="status" value="REJECTED" class="btn btn-danger fw-bold py-2">
                            <i class="material-symbols-outlined align-middle">close</i> TỪ CHỐI ĐƠN NÀY
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>