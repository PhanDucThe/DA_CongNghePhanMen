@model IEnumerable<congnghephanmem.Models.prescription>

@{
    ViewBag.Title = "Quản lý Đơn thuốc";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .badge-status {
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 11px;
        text-transform: uppercase;
    }

    .bg-pending {
        background-color: #fff7ed;
        color: #c2410c;
        border: 1px solid #ffedd5;
    }

    .bg-approved {
        background-color: #f0fdf4;
        color: #15803d;
        border: 1px solid #dcfce7;
    }

    .bg-rejected {
        background-color: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fee2e2;
    }

    .prescription-thumb {
        width: 50px;
        height: 50px;
        object-fit: cover;
        border-radius: 6px;
        border: 1px solid #e2e8f0;
        cursor: pointer;
        transition: transform 0.2s;
    }

        .prescription-thumb:hover {
            transform: scale(1.5);
            z-index: 10;
            position: relative;
        }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-dark m-0">Quản lý Đơn thuốc</h4>
        <p class="text-muted small m-0 mt-1">Danh sách yêu cầu tư vấn thuốc từ khách hàng.</p>
    </div>
</div>

<div class="chart-box p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-uppercase text-muted small fw-bold">
                <tr>
                    <th class="px-4 py-3">ID</th>
                    <th class="py-3">Khách hàng</th>
                    <th class="py-3">Hình ảnh</th>
                    <th class="py-3">Ghi chú</th>
                    <th class="py-3">Thời gian gửi</th>
                    <th class="py-3 text-center">Trạng thái</th>
                    <th class="py-3 text-end px-4">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="px-4 fw-bold text-muted">#@item.id</td>
                            <td>
                                <div class="fw-bold text-dark">@item.user.full_name</div>
                                <div class="small text-muted">@item.user.phone_number</div>
                            </td>
                            <td>
                                <img src="@item.image_url" class="prescription-thumb shadow-sm" onclick="window.open(this.src)">
                            </td>
                            <td style="max-width: 200px;">
                                <div class="text-truncate text-muted small" title="@item.note">
                                    @(string.IsNullOrEmpty(item.note) ? "Không có ghi chú" : item.note)
                                </div>
                            </td>
                            <td class="text-muted small">
                                @item.created_at.Value.ToString("dd/MM/yyyy") <br>
                                @item.created_at.Value.ToString("HH:mm")
                            </td>
                            <td class="text-center">
                                @if (item.status == "PENDING")
                                {
                                    <span class="badge-status bg-pending">Chờ xử lý</span>
                                }
                                else if (item.status == "APPROVED")
                                {
                                    <span class="badge-status bg-approved">Đã duyệt</span>
                                }
                                else
                                {
                                    <span class="badge-status bg-rejected">Từ chối</span>
                                }
                            </td>
                            <td class="text-end px-4">
                                @if (item.status == "PENDING")
                                {
                                    <a href="@Url.Action("Process", new { id = item.id })" class="btn btn-sm btn-primary fw-bold shadow-sm">
                                        Xử lý ngay
                                    </a>
                                }
                                else
                                {
                                    <a href="@Url.Action("Process", new { id = item.id })" class="btn btn-sm btn-light text-muted border">
                                        Xem lại
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <img src="https://cdn-icons-png.flaticon.com/512/4076/4076432.png" width="60" class="opacity-25 mb-3 d-block mx-auto">
                            Chưa có đơn thuốc nào cần xử lý.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>