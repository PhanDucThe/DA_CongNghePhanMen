@model IEnumerable<congnghephanmem.Controllers.UserViewModel>

@{
    ViewBag.Title = "Quản lý Khách Hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    /* Custom style để giống mẫu Tailwind */
    .search-box input {
        border-radius: 8px 0 0 8px;
        border-right: none;
    }

    .search-box button {
        border-radius: 0 8px 8px 0;
    }

    .table-users th {
        background: #F8FAFC;
        color: #64748B;
        font-size: 12px;
        text-transform: uppercase;
        font-weight: 700;
        padding: 16px 24px;
        border-bottom: 1px solid #E2E8F0;
    }

    .table-users td {
        padding: 16px 24px;
        vertical-align: middle;
        border-bottom: 1px solid #F1F5F9;
        font-size: 14px;
    }

    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
        background-color: #eee;
    }

    /* Badges */
    .badge-vip {
        background: #FEF9C3;
        color: #854D0E;
        border: 1px solid #FEF08A;
    }
    /* Vàng nhạt */
    .badge-new {
        background: #DBEAFE;
        color: #1E40AF;
        border: 1px solid #BFDBFE;
    }
    /* Xanh dương nhạt */
    .badge-member {
        background: #F3F4F6;
        color: #374151;
        border: 1px solid #E5E7EB;
    }
    /* Xám */

    .status-active {
        background: #DCFCE7;
        color: #166534;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .status-blocked {
        background: #FEE2E2;
        color: #991B1B;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .action-link {
        font-weight: 600;
        text-decoration: none;
        font-size: 13px;
        margin-left: 10px;
    }

    .text-teal {
        color: var(--admin-primary);
    }

    .text-red {
        color: #DC2626;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="text-muted small m-0 mt-1">Danh sách khách hàng và lịch sử chi tiêu.</p>
    </div>

    <div class="d-flex gap-3">
        <form action="@Url.Action("Index")" method="get" class="d-flex search-box shadow-sm">
            <input type="text" name="keyword" class="form-control border-0" placeholder="Tìm kiếm khách hàng..." value="@Request["keyword"]" style="width: 250px;">
            <button class="btn btn-white bg-white border-0 text-secondary"><i class="material-symbols-outlined align-middle">search</i></button>
        </form>

        <a href="@Url.Action("Create", "AdminUser")" class="btn text-white fw-bold shadow-sm d-flex align-items-center gap-2" style="background-color: var(--admin-primary);">
            <span class="material-symbols-outlined fs-5">add</span>
            Thêm Khách Hàng
        </a>
    </div>
</div>

<div class="chart-box p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-borderless table-users mb-0">
            <thead>
                <tr>
                    <th>KHÁCH HÀNG</th>
                    <th>SỐ ĐIỆN THOẠI</th>
                    <th>NHÓM KHÁCH HÀNG</th>
                    <th>TỔNG CHI TIÊU</th>
                    <th>NGÀY THAM GIA</th>
                    <th>TRẠNG THÁI</th>
                    <th class="text-end">HÀNH ĐỘNG</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        string groupClass = item.CustomerGroup == "VIP" ? "badge-vip" : (item.CustomerGroup == "Mới" ? "badge-new" : "badge-member");
                        string avatarUrl = string.IsNullOrEmpty(item.Avatar) ? "https://i.pravatar.cc/150?u=" + item.Id : item.Avatar;

                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@avatarUrl" class="avatar-circle">
                                    <div>
                                        <div class="fw-bold text-dark">@item.FullName</div>
                                        <div class="text-muted small">@item.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td class="text-muted">@item.Phone</td>
                            <td>
                                <span class="badge rounded-pill @groupClass text-uppercase" style="font-weight: 700; padding: 6px 12px; font-size: 10px;">@item.CustomerGroup</span>
                            </td>
                            <td class="fw-bold text-dark">@string.Format("{0:0,0}đ", item.TotalSpent)</td>
                            <td class="text-muted">@item.CreatedAt.Value.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.IsActive == true)
                                {
                                    <span class="status-active">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="status-blocked">Bị khóa</span>
                                }
                            </td>
                            <td class="text-end">
                                <a href="@Url.Action("Details", "AdminUser", new {id = item.Id})" class="action-link text-teal">Xem chi tiết</a>

                                @if (item.IsActive == true)
                                {
                                    <a href="@Url.Action("ToggleStatus", new { id = item.Id })" class="action-link text-red" onclick="return confirm('Bạn có chắc muốn khóa tài khoản này?');">Khóa</a>
                                }
                                else
                                {
                                    <a href="@Url.Action("ToggleStatus", new { id = item.Id })" class="action-link text-success" onclick="return confirm('Mở khóa tài khoản này?');">Mở khóa</a>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">Không tìm thấy khách hàng nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top bg-light">
        <small class="text-muted">Hiển thị @Model.Count() kết quả</small>
        <div class="btn-group">
            <button class="btn btn-sm btn-white border"><</button>
            <button class="btn btn-sm text-white border" style="background-color: var(--admin-primary);">1</button>
            <button class="btn btn-sm btn-white border">2</button>
            <button class="btn btn-sm btn-white border">3</button>
            <button class="btn btn-sm btn-white border">...</button>
            <button class="btn btn-sm btn-white border">></button>
        </div>
    </div>
</div>