@model congnghephanmem.ViewModels.CreateUserViewModel

@{
    ViewBag.Title = "Thêm Khách Hàng Mới";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="chart-box">
            <div class="d-flex align-items-center gap-2 mb-4">
                <a href="@Url.Action("Index")" class="text-decoration-none text-muted">
                    <span class="material-symbols-outlined">arrow_back</span>
                </a>
                <h4 class="fw-bold m-0">Thêm khách hàng mới</h4>
            </div>

            @using (Html.BeginForm("Create", "AdminUser", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()

                <div class="row g-5">
                    <div class="col-lg-8">
                        <h6 class="fw-bold mb-3 text-primary">Thông tin cá nhân</h6>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Họ và tên <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Nhập họ tên khách hàng" })
                            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold small text-muted">Email <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "example@email.com" })
                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold small text-muted">Số điện thoại <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "09xxxxxxxx" })
                                @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Mật khẩu khởi tạo <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.Password, new { @class = "form-control", placeholder = "Mật khẩu đăng nhập" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="card border-0 bg-light p-4 rounded-3 text-center">
                            <h6 class="fw-bold mb-3 text-start">Ảnh đại diện</h6>

                            <div class="mb-3 d-flex justify-content-center">
                                <div style="width: 150px; height: 150px; border-radius: 50%; overflow: hidden; border: 3px solid #fff; box-shadow: 0 5px 15px rgba(0,0,0,0.1);">
                                    <img id="previewAvatar" src="https://via.placeholder.com/150?text=Avatar" style="width: 100%; height: 100%; object-fit: cover;" />
                                </div>
                            </div>

                            <label class="btn btn-white border fw-bold text-secondary w-100 mb-3 cursor-pointer">
                                <i class="material-symbols-outlined align-middle">cloud_upload</i> Chọn ảnh
                                <input type="file" name="AvatarFile" id="AvatarFile" class="d-none" onchange="previewImage(this);" accept="image/*" />
                            </label>
                            <small class="text-muted d-block text-start">Hỗ trợ: JPG, PNG, JPEG.</small>
                        </div>

                        <div class="mt-4">
                            <label class="form-label fw-bold small text-muted">Trạng thái</label>
                            <div class="form-check form-switch">
                                @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", @checked = "checked" })
                                <label class="form-check-label" for="IsActive">Kích hoạt ngay</label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mt-4 py-2 fw-bold text-uppercase shadow-sm" style="background-color: var(--admin-primary); border: none;">
                            Lưu khách hàng
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script>
    function previewImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('previewAvatar').src = e.target.result;
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>