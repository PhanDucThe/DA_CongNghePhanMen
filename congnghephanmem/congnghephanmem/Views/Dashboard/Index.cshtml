@{
    ViewBag.Title = "Tổng quan";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    /* Card Stats */
    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.02);
        height: 100%;
        transition: transform 0.2s;
    }

        .stat-card:hover {
            transform: translateY(-3px);
        }

    .text-up {
        color: #00C092;
    }

    .text-down {
        color: #FF4D4D;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .icon-blue {
        background: #E3F5FF;
        color: #0099FF;
    }

    .icon-green {
        background: #E5F9F1;
        color: #00C092;
    }

    .icon-orange {
        background: #FFF4E5;
        color: #FF9F43;
    }

    .icon-purple {
        background: #F3E5F5;
        color: #9C27B0;
    }

    .stat-value {
        font-size: 26px;
        font-weight: 700;
        margin: 10px 0 5px;
        color: #111;
    }

    .stat-label {
        color: #8A92A6;
        font-size: 14px;
        font-weight: 500;
    }

    .stat-trend {
        font-size: 12px;
        font-weight: 600;
    }

    .text-up {
        color: #00C092;
    }

    .text-down {
        color: #FF4D4D;
    }

    /* Charts Container */
    .chart-box {
        background: white;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.02);
        margin-bottom: 24px;
    }

    .chart-title {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 20px;
        color: #111;
    }

    /* Table */
    .table-custom th {
        color: #8A92A6;
        font-weight: 600;
        border-bottom: 1px solid #eee;
        padding-bottom: 15px;
    }

    .table-custom td {
        padding: 15px 10px;
        vertical-align: middle;
        font-weight: 500;
        color: #333;
    }

    .status-badge {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-success {
        background: #E5F9F1;
        color: #00C092;
    }

    .status-pending {
        background: #FFF4E5;
        color: #FF9F43;
    }
</style>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Tổng doanh thu</div>
                    <div class="stat-value">@string.Format("{0:0,0}đ", Model.TotalRevenue)</div>

                    @if (Model.RevenueGrowth >= 0)
                    {
                        <div class="stat-trend text-up">+@Model.RevenueGrowth.ToString("0.0")% so với tháng trước</div>
                    }
                    else
                    {
                        <div class="stat-trend text-down">@Model.RevenueGrowth.ToString("0.0")% so với tháng trước</div>
                    }
                </div>
                <div class="stat-icon icon-blue">
                    <span class="material-symbols-outlined">payments</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Đơn hàng mới</div>
                    <div class="stat-value">@Model.NewOrdersToday</div>
                    <div class="stat-trend text-muted">Trong 24 giờ qua</div>
                </div>
                <div class="stat-icon icon-green">
                    <span class="material-symbols-outlined">shopping_cart</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Sắp hết hàng</div>
                    <div class="stat-value">@Model.ProductsOutOfStock</div>
                    <div class="stat-trend text-down">Cần nhập thêm</div>
                </div>
                <div class="stat-icon icon-orange">
                    <span class="material-symbols-outlined">inventory_2</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Khách hàng mới</div>
                    <div class="stat-value">@Model.NewCustomersThisWeek</div>
                    <div class="stat-trend text-muted">Trong 7 ngày qua</div>
                </div>
                <div class="stat-icon icon-purple">
                    <span class="material-symbols-outlined">person_add</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="chart-box h-100">
            <h5 class="chart-title">Doanh thu 7 ngày qua (Triệu VNĐ)</h5>
            <div style="height: 300px;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="chart-box h-100">
            <h5 class="chart-title">Tỷ lệ đơn hàng</h5>
            <div class="d-flex justify-content-center" style="height: 250px;">
                <canvas id="orderStatusChart"></canvas>
            </div>
            <div class="mt-4 text-center d-flex justify-content-center gap-3">
                <small><span class="text-success">●</span> Hoàn thành (@Model.OrderCompleted)</small>
                <small><span class="text-primary">●</span> Đang xử lý (@Model.OrderShipping)</small>
                <small><span class="text-danger">●</span> Hủy (@Model.OrderCancelled)</small>
            </div>
        </div>
    </div>
</div>

<div class="chart-box">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="chart-title m-0">Đơn hàng gần đây</h5>
        <a href="@Url.Action("Index", "Order")" class="btn btn-sm btn-light text-primary fw-bold">Xem tất cả</a>
    </div>

    <div class="table-responsive">
        <table class="table table-borderless table-custom">
            <thead>
                <tr>
                    <th>MÃ ĐƠN</th>
                    <th>KHÁCH HÀNG</th>
                    <th>NGÀY ĐẶT</th>
                    <th>TỔNG TIỀN</th>
                    <th>TRẠNG THÁI</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.RecentOrders)
                {
                    <tr>
                        <td><span class="fw-bold">#@order.id</span></td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="bg-light rounded-circle d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;">
                                    <span class="material-symbols-outlined fs-6 text-muted">person</span>
                                </div>
                                @(order.user != null ? order.user.full_name : "Khách vãng lai")
                            </div>
                        </td>
                        <td>@order.created_at.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="fw-bold text-dark">@string.Format("{0:0,0}đ", order.total_money)</td>
                        <td>
                            @if (order.status == "DELIVERED" || order.status == "Hoàn thành")
                            {
                                <span class="status-badge status-success">Hoàn thành</span>
                            }
                            else if (order.status == "CANCELLED" || order.status == "Đã hủy")
                            {
                                <span class="status-badge bg-danger text-white">Đã hủy</span>
                            }
                            else
                            {
                                <span class="status-badge status-pending">@order.status</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    // Lấy dữ liệu từ C# Model và chuyển thành JSON để JS hiểu
    var revenueLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.RevenueLabels));
    var revenueData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.RevenueData));

    var countCompleted = @Model.OrderCompleted;
    var countShipping = @Model.OrderShipping;
    var countCancelled = @Model.OrderCancelled;

    // 1. Line Chart (Doanh thu)
    const ctx1 = document.getElementById('revenueChart').getContext('2d');
    let gradient = ctx1.createLinearGradient(0, 0, 0, 400);
    gradient.addColorStop(0, 'rgba(0, 192, 146, 0.2)');
    gradient.addColorStop(1, 'rgba(0, 192, 146, 0)');

    new Chart(ctx1, {
        type: 'line',
        data: {
            labels: revenueLabels, // Dùng dữ liệu thật
            datasets: [{
                label: 'Doanh thu (Triệu đ)',
                data: revenueData, // Dùng dữ liệu thật
                borderColor: '#00C092',
                backgroundColor: gradient,
                borderWidth: 3,
                tension: 0.4,
                fill: true,
                pointBackgroundColor: '#fff',
                pointBorderColor: '#00C092',
                pointBorderWidth: 2,
                pointRadius: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, grid: { borderDash: [5, 5] } },
                x: { grid: { display: false } }
            }
        }
    });

    // 2. Donut Chart (Trạng thái)
    const ctx2 = document.getElementById('orderStatusChart').getContext('2d');
    new Chart(ctx2, {
        type: 'doughnut',
        data: {
            labels: ['Hoàn thành', 'Đang xử lý', 'Đã hủy'],
            datasets: [{
                data: [countCompleted, countShipping, countCancelled], // Dùng dữ liệu thật
                backgroundColor: ['#00C092', '#3B82F6', '#EF4444'],
                borderWidth: 0,
                hoverOffset: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '75%',
            plugins: { legend: { display: false } }
        }
    });
</script>