@model IEnumerable<congnghephanmem.Models.product>

@{
    ViewBag.Title = "Quản lý Sản Phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var db = new congnghephanmem.Models.db_cnpmEntities(); 
}

<style>

    .form-switch .form-check-input {
        width: 3em;
        height: 1.5em;
        cursor: pointer;
        background-color: #ccc;
        border: none;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 8 8'%3e%3ccircle r='3' fill='%23fff'/%3e%3c/svg%3e");
    }

        .form-switch .form-check-input:checked {
            background-color: var(--admin-primary);
            border-color: var(--admin-primary);
        }

    .table-products th {
        background: #F8FAFC;
        color: #64748B;
        font-size: 12px;
        text-transform: uppercase;
        font-weight: 700;
        padding: 15px;
        border-bottom: 1px solid #E2E8F0;
    }

    .table-products td {
        padding: 15px;
        vertical-align: middle;
        border-bottom: 1px solid #F1F5F9;
        font-size: 14px;
    }

    .prod-img {
        width: 48px;
        height: 48px;
        border-radius: 8px;
        object-fit: cover;
        border: 1px solid #eee;
    }

    /* Filters */
    .filter-btn {
        border: none;
        background: none;
        padding: 8px 16px;
        font-weight: 600;
        color: #64748B;
        border-bottom: 2px solid transparent;
        font-size: 14px;
        text-decoration: none;
    }

        .filter-btn:hover {
            color: #333;
        }

        .filter-btn.active {
            color: var(--admin-primary);
            border-bottom-color: var(--admin-primary);
        }

    .badge-stock-low {
        background: #FEE2E2;
        color: #991B1B;
    }

    .badge-stock-ok {
        background: #DCFCE7;
        color: #166534;
    }
</style>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <p class="text-muted small m-0 mt-1">Hệ thống quản lý kho thuốc dành cho quản trị viên.</p>
    </div>

    <a href="@Url.Action("Create", "AdminProduct")" class="btn text-white fw-bold shadow-sm d-flex align-items-center gap-2 px-4" style="background-color: var(--admin-primary);">
        <span class="material-symbols-outlined fs-5">add</span> Thêm Sản Phẩm Mới
    </a>
</div>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 gap-3">

    <div class="d-flex border-bottom w-100 w-md-auto overflow-auto">
        <a href="@Url.Action("Index")" class="filter-btn @(string.IsNullOrEmpty(ViewBag.CurrentFilter) ? "active" : "")">Tất cả</a>
        <a href="@Url.Action("Index", new { filter = "low_stock" })" class="filter-btn @(ViewBag.CurrentFilter == "low_stock" ? "active" : "")">Sắp hết hàng</a>
        <a href="@Url.Action("Index", new { filter = "hidden" })" class="filter-btn @(ViewBag.CurrentFilter == "hidden" ? "active" : "")">Đang ẩn</a>
    </div>

    <form action="@Url.Action("Index")" method="get" class="position-relative" style="width: 300px;">
        <span class="material-symbols-outlined position-absolute text-muted" style="left: 10px; top: 10px;">search</span>
        <input type="text" name="keyword" class="form-control ps-5 border-0 shadow-sm" placeholder="Tìm kiếm sản phẩm..." value="@ViewBag.CurrentKeyword">
        <input type="hidden" name="filter" value="@ViewBag.CurrentFilter" />
    </form>
</div>

<div class="chart-box p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-borderless table-products mb-0">
            <thead>
                <tr>
                    <th width="80">HÌNH ẢNH</th>
                    <th>TÊN THUỐC</th>
                    <th>DANH MỤC</th>
                    <th>GIÁ BÁN</th>
                    <th>KHO</th>
                    <th>TRẠNG THÁI</th>
                    <th class="text-end">HÀNH ĐỘNG</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var categoryName = db.categories.Find(item.category_id)?.name ?? "Không có";
                        string stockClass = item.stock_quantity < 10 ? "badge-stock-low" : "badge-stock-ok";

                        <tr>
                            <td>
                                <img src="@item.thumbnail_url" class="prod-img" onerror="this.src='https://via.placeholder.com/48'">
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.name</div>
                                <div class="text-muted small">SKU: @item.sku</div>
                            </td>
                            <td class="text-muted">@categoryName</td>
                            <td class="fw-bold text-dark">@string.Format("{0:0,0}đ", item.sale_price)</td>
                            <td>
                                <span class="badge rounded-pill @stockClass" style="font-size: 11px; padding: 4px 10px;">@item.stock_quantity</span>
                            </td>
                            <td>
                                <form action="@Url.Action("ToggleStatus")" method="post">
                                    <input type="hidden" name="id" value="@item.id" />
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" onchange="this.form.submit()" @(item.is_active == true ? "checked" : "")>
                                    </div>
                                </form>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a href="@Url.Action("Edit", new { id = item.id })" class="btn btn-light btn-sm text-primary" title="Sửa">
                                        <span class="material-symbols-outlined fs-5">edit</span>
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = item.id })" class="btn btn-light btn-sm text-danger" title="Xóa" onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">
                                        <span class="material-symbols-outlined fs-5">delete</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">Không tìm thấy sản phẩm nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>