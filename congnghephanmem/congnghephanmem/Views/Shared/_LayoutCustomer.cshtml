<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Nhà Thuốc Online</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" />

    <style>
        :root {
            --primary-color: #13ecc8; /* Màu xanh Mint chủ đạo */
            --primary-bg-light: #f0fdfa;
            --text-dark: #10221f;
        }

        body {
            font-family: 'Manrope', sans-serif;
            background-color: #f6f8f8;
            color: #333;
        }

        /* --- CUSTOM COLORS --- */
        .text-primary-custom {
            color: #00bfa5 !important;
        }

        .bg-primary-custom {
            background-color: var(--primary-color) !important;
        }

        /* Buttons */
        .btn-mint {
            background-color: rgba(19, 236, 200, 0.15);
            color: #009688;
            font-weight: 700;
            border: none;
        }

            .btn-mint:hover {
                background-color: rgba(19, 236, 200, 0.3);
                color: #00796b;
            }

        .btn-primary-custom {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            color: #fff;
            font-weight: 600;
        }

            .btn-primary-custom:hover {
                background-color: #0ebdb2; /* Đậm hơn chút khi hover */
                color: #fff;
            }

        .btn-outline-custom {
            border: 2px solid #ddd;
            color: #555;
            font-weight: 600;
        }

            .btn-outline-custom:hover {
                border-color: var(--primary-color);
                color: var(--primary-color);
                background: #fff;
            }

        /* Header Elements */
        .search-container {
            background-color: #f3f4f6;
            border-radius: 8px;
            padding: 5px 15px;
        }

        .search-input {
            border: none;
            background: transparent;
            box-shadow: none !important;
        }

        .icon-btn {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #f3f4f6;
            border-radius: 8px;
            color: #333;
            border: none;
        }

        /* Nav Links */
        .nav-link {
            font-weight: 500;
            color: #333;
        }

            .nav-link:hover {
                color: var(--primary-color);
            }

            .nav-link.active {
                color: #00bfa5;
                font-weight: 700;
            }

        /* Products */
        .card-product {
            border: none;
            border-radius: 12px;
            transition: all 0.3s ease;
            background: #fff;
        }

            .card-product:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.05);
            }

        /* User Dropdown */
        .user-avatar {
            width: 40px;
            height: 40px;
            background-size: cover;
            background-position: center;
            border-radius: 50%;
            cursor: pointer;
            border: 2px solid #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
    </style>
</head>
<body>

    <header class="bg-white sticky-top shadow-sm py-2">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between">

                <div class="d-flex align-items-center gap-4">
                    <a href="@Url.Action("Index", "Home")" class="d-flex align-items-center text-decoration-none text-dark gap-2">
                        <span class="material-symbols-outlined fs-2" style="color: var(--primary-color)">spark</span>
                        <h5 class="m-0 fw-bold">Nhà Thuốc Online</h5>
                    </a>

                    <form action="@Url.Action("Index", "Home")" method="get" class="d-none d-md-flex search-container align-items-center" style="width: 300px;">
                        <button type="submit" class="border-0 bg-transparent p-0 d-flex"><span class="material-symbols-outlined text-muted">search</span></button>
                        <input type="text" name="keyword" class="form-control search-input" placeholder="Tìm kiếm sản phẩm...">
                    </form>
                </div>

                <div class="d-none d-lg-flex align-items-center gap-4">
                    <a href="@Url.Action("Index", "Home")" class="nav-link active" style="margin-left: 5px">Trang chủ</a>
                    <a href="@Url.Action("Index", "Product")" class="nav-link">Thuốc</a>
                    <a href="#" class="nav-link">Vitamin & Khoáng Chất</a> <a href="#" class="nav-link">Chăm sóc cá nhân</a>
                </div>

                <div class="d-flex align-items-center gap-3">

                    <a href="@Url.Action("Index", "Cart")" class="icon-btn position-relative text-decoration-none">
                        <span class="material-symbols-outlined">shopping_cart</span>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem;">3</span>
                    </a>

                    @if (Session["User"] != null)
                    {
                        // TRƯỜNG HỢP: ĐÃ ĐĂNG NHẬP -> Hiện Avatar + Dropdown
                        var avatarUrl = Session["UserAvatar"] as string;
                        if (string.IsNullOrEmpty(avatarUrl)) { avatarUrl = "https://i.pravatar.cc/150"; } // Ảnh mặc định

                        <div class="dropdown">
                            <div class="user-avatar"
                                 data-bs-toggle="dropdown"
                                 aria-expanded="false"
                                 style="background-image: url('@avatarUrl');">
                            </div>
                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow mt-2">
                                <li><h6 class="dropdown-header">Xin chào, @Session["UserName"]</h6></li>
                                <li><a class="dropdown-item" href="/Account/Profile">Tài khoản của tôi</a></li>
                                <li><a class="dropdown-item" href="/Order/MyOrders">Đơn hàng</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="@Url.Action("Logout", "Account")">Đăng xuất</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        // TRƯỜNG HỢP: CHƯA ĐĂNG NHẬP -> Hiện nút Đăng nhập / Đăng ký
                        <div class="d-flex gap-2">
                            <a href="@Url.Action("Login", "Account")" class="btn btn-outline-custom btn-sm px-3 rounded-pill">Đăng nhập</a>
                            <a href="@Url.Action("Register", "Account")" class="btn btn-primary-custom btn-sm px-3 rounded-pill">Đăng ký</a>
                        </div>
                    }

                </div>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>