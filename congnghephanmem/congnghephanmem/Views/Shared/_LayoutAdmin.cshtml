<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quản Trị Viên - Nhà Thuốc Online</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        :root {
            --admin-primary: #00C092;
            --admin-dark: #1A1A1A;
            --admin-text-gray: #8A92A6;
            --sidebar-width: 260px;
        }

        body {
            font-family: 'Manrope', sans-serif;
            background-color: #F5F6FA;
            overflow-x: hidden;
        }

        /* SIDEBAR */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            background-color: var(--admin-dark);
            position: fixed;
            top: 0;
            left: 0;
            padding: 20px;
            z-index: 1000;
            transition: all 0.3s;
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            color: white;
            font-weight: 700;
            font-size: 1.2rem;
            margin-bottom: 40px;
            padding-left: 10px;
            text-decoration: none;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 12px 20px;
            color: var(--admin-text-gray);
            text-decoration: none;
            border-radius: 8px;
            margin-bottom: 5px;
            font-weight: 500;
            transition: all 0.2s;
        }

            .nav-item:hover {
                background-color: rgba(255,255,255,0.05);
                color: white;
            }

            /* Class active sẽ được thêm động bằng C# */
            .nav-item.active {
                background-color: var(--admin-primary);
                color: white;
                box-shadow: 0 4px 15px rgba(0, 192, 146, 0.3);
            }

        .nav-icon {
            font-size: 20px;
        }

        .main-content {
            margin-left: var(--sidebar-width);
            padding: 20px 30px;
        }

        /* Header & Footer styles giữ nguyên */
        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            background: transparent;
        }

        .header-title {
            font-size: 24px;
            font-weight: 700;
            color: #111;
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .notif-btn {
            background: white;
            border: none;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #555;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }

        .avatar-admin {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background-color: #eee;
            background-image: url('https://i.pravatar.cc/150?img=11');
            background-size: cover;
        }

        .admin-info small {
            color: var(--admin-text-gray);
            display: block;
            font-size: 12px;
        }

        .admin-info span {
            font-weight: 600;
            font-size: 14px;
        }

        .admin-footer-link {
            position: fixed;
            bottom: 20px;
            left: 20px;
            width: 220px;
            color: var(--admin-text-gray);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px;
        }

            .admin-footer-link:hover {
                color: white;
            }
    </style>
</head>
<body>

    @{
        // Lấy tên Controller hiện tại từ URL
        string currentController = ViewContext.RouteData.Values["controller"]?.ToString();

        // Hàm trả về chuỗi "active" nếu tên controller khớp
        string ActiveClass(string controllerName)
        {
            return currentController == controllerName ? "active" : "";
        }
    }

    <div class="sidebar">
        <a href="#" class="brand-logo">
            <span class="material-symbols-outlined text-success">admin_panel_settings</span>
            Quản Trị viên
        </a>

        <nav class="d-flex flex-column">

            <a href="/Dashboard" class="nav-item @ActiveClass("Dashboard")">
                <span class="material-symbols-outlined nav-icon">dashboard</span>
                Tổng quan
            </a>

            <a href="#" class="nav-item @ActiveClass("Order")">
                <span class="material-symbols-outlined nav-icon">receipt_long</span>
                Đơn hàng
            </a>

            <a href="#" class="nav-item @ActiveClass("AdminProduct")">
                <span class="material-symbols-outlined nav-icon">inventory_2</span>
                Sản phẩm
            </a>

            <a href="#" class="nav-item @ActiveClass("AdminUser")">
                <span class="material-symbols-outlined nav-icon">group</span>
                Khách hàng
            </a>

            <a href="@Url.Action("Index", "Coupon")" class="nav-item @ActiveClass("Coupon")">
                <span class="material-symbols-outlined nav-icon">sell</span>
                Mã khuyến mãi
            </a>

            <a href="#" class="nav-item @ActiveClass("Review")">
                <span class="material-symbols-outlined nav-icon">rate_review</span>
                Đánh giá
            </a>

            <a href="@Url.Action("Index", "Post")" class="nav-item @ActiveClass("Post")">
                <span class="material-symbols-outlined nav-icon">article</span>
                Bài viết
            </a>
        </nav>

        <a href="#" class="admin-footer-link">
            <span class="material-symbols-outlined">settings</span> Cài đặt
        </a>
    </div>

    <div class="main-content">
        <header class="admin-header">
            <h2 class="header-title">@ViewBag.Title</h2>
            <div class="user-profile">
                <button class="notif-btn">
                    <span class="material-symbols-outlined">notifications</span>
                </button>
                <div class="d-flex align-items-center gap-3 bg-white p-2 rounded-pill shadow-sm pe-4">
                    <div class="avatar-admin"></div>
                    <div class="admin-info">
                        <span>Admin</span>
                        <small>admin@nhathuoc.com</small>
                    </div>
                </div>
            </div>
        </header>

        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>