@model congnghephanmem.Models.post

@{
    ViewBag.Title = Model.title;
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
    var relatedPosts = ViewBag.RelatedPosts as List<congnghephanmem.Models.post>;

    string currentUrl = Request.Url.AbsoluteUri;
}

<style>
    .post-content img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        margin: 15px 0;
    }

    .post-content h2 {
        color: #009688;
        font-weight: 700;
        margin-top: 30px;
        font-size: 1.5rem;
    }

    .post-content h3 {
        font-weight: 600;
        margin-top: 25px;
        font-size: 1.25rem;
    }

    .post-content p {
        line-height: 1.8;
        color: #333;
        margin-bottom: 15px;
        font-size: 1.1rem;
    }

    .share-btn {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        text-decoration: none;
        transition: 0.2s;
    }

        .share-btn:hover {
            transform: translateY(-3px);
            opacity: 0.9;
            color: white;
        }
</style>

<div class="container py-5">
    <div class="row g-5">
        <div class="col-lg-8">
            <div class="mb-4">
                <a href="@Url.Action("Index", "Blog", new { categoryId = Model.category_id })" class="badge bg-primary-custom text-white text-decoration-none mb-2">
                    @Model.post_categories.name
                </a>
                <h1 class="fw-bold text-dark lh-base mb-3">@Model.title</h1>

                <div class="d-flex align-items-center gap-4 text-muted small">
                    <span><i class="material-symbols-outlined align-middle fs-6">calendar_today</i> @Model.published_at.Value.ToString("dd/MM/yyyy")</span>
                    <span><i class="material-symbols-outlined align-middle fs-6">person</i> @Model.user.full_name</span>
                    <span><i class="material-symbols-outlined align-middle fs-6">visibility</i> @Model.view_count lượt xem</span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.thumbnail_url))
            {
                <img src="@Model.thumbnail_url" class="w-100 rounded-3 shadow-sm mb-4" alt="@Model.title">
            }

            <div class="post-content">
                <p class="fw-bold fs-5 text-secondary fst-italic">@Model.excerpt</p>
                <hr class="my-4" />
                @Html.Raw(Model.content)
            </div>

            <div class="bg-light p-4 rounded-3 mt-5 border">
                <h6 class="fw-bold mb-3">Chia sẻ bài viết này:</h6>
                <div class="d-flex gap-2">
                    <a href="https://www.facebook.com/sharer/sharer.php?u=@currentUrl" target="_blank" class="share-btn" style="background: #1877f2;"><i class="fab fa-facebook-f"></i> F</a>
                    <a href="http://twitter.com/share?text=@Model.title&url=@currentUrl" target="_blank" class="share-btn" style="background: #1da1f2;"><i class="fab fa-twitter"></i> T</a>
                    <a href="mailto:?subject=@Model.title&body=@currentUrl" class="share-btn" style="background: #ea4335;"><i class="fas fa-envelope"></i> M</a>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="sticky-top" style="top: 100px;">
                <div class="bg-white p-4 rounded-3 shadow-sm border">
                    <h5 class="fw-bold mb-4">Bài viết cùng chuyên mục</h5>

                    @if (relatedPosts != null && relatedPosts.Any())
                    {
                        <div class="d-flex flex-column gap-4">
                            @foreach (var item in relatedPosts)
                            {
                                <div class="d-flex gap-3">
                                    <a href="/bai-viet/@item.slug" class="flex-shrink-0">
                                        <img src="@(string.IsNullOrEmpty(item.thumbnail_url) ? "/Content/images/no-image.jpg" : item.thumbnail_url)" class="rounded" style="width: 80px; height: 80px; object-fit: cover;">
                                    </a>
                                    <div>
                                        <h6 class="fw-bold mb-1" style="line-height: 1.4;">
                                            <a href="/bai-viet/@item.slug" class="text-decoration-none text-dark hover-text-primary">@item.title</a>
                                        </h6>
                                        <small class="text-muted">@item.published_at.Value.ToString("dd/MM/yyyy")</small>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small">Không có bài viết liên quan.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>