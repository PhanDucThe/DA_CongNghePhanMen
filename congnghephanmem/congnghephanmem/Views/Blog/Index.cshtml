@model IEnumerable<congnghephanmem.Models.post>

@{
    ViewBag.Title = ViewBag.CurrentCategory != null ? "Chuyên mục: " + ViewBag.CurrentCategory : "Góc sức khỏe";
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
    var categories = ViewBag.Categories as List<congnghephanmem.Models.post_categories>;
}

<style>
    .blog-card {
        border: none;
        border-radius: 12px;
        transition: all 0.3s;
        height: 100%;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

        .blog-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(19, 236, 200, 0.2);
        }

    .blog-thumb {
        height: 200px;
        object-fit: cover;
        border-radius: 12px 12px 0 0;
    }

    .blog-cat-badge {
        background: rgba(19, 236, 200, 0.1);
        color: #009688;
        font-size: 12px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 20px;
    }

    .sidebar-link {
        display: block;
        padding: 10px 15px;
        border-radius: 8px;
        color: #555;
        text-decoration: none;
        transition: 0.2s;
        font-weight: 500;
    }

        .sidebar-link:hover {
            background: #f0fdfa;
            color: #009688;
            padding-left: 20px;
        }
</style>

<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
            <li class="breadcrumb-item active fw-bold text-dark">Góc sức khỏe</li>
        </ol>
    </nav>

    <div class="row g-5">
        <div class="col-lg-8">
            <h2 class="fw-bold mb-4">@(ViewBag.CurrentCategory != null ? ViewBag.CurrentCategory : "Bài viết mới nhất")</h2>

            @if (Model.Any())
            {
                <div class="row g-4">
                    @foreach (var item in Model)
                    {
                        <div class="col-md-6">
                            <div class="card blog-card">
                                <a href="/bai-viet/@item.slug">
                                    <img src="@(string.IsNullOrEmpty(item.thumbnail_url) ? "/Content/images/no-image.jpg" : item.thumbnail_url)" class="card-img-top blog-thumb" alt="@item.title">
                                </a>
                                <div class="card-body p-4 d-flex flex-column">
                                    <div class="mb-2">
                                        <span class="blog-cat-badge">@item.post_categories.name</span>
                                        <small class="text-muted ms-2"><i class="material-symbols-outlined align-middle fs-6">calendar_today</i> @item.published_at.Value.ToString("dd/MM/yyyy")</small>
                                    </div>
                                    <h5 class="card-title fw-bold mb-2">
                                        <a href="/bai-viet/@item.slug" class="text-decoration-none text-dark stretched-link">@item.title</a>
                                    </h5>
                                    <p class="card-text text-muted small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                        @item.excerpt
                                    </p>
                                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-light rounded-circle d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;">
                                                <i class="material-symbols-outlined fs-6 text-muted">person</i>
                                            </div>
                                            <small class="fw-bold text-muted">@item.user.full_name</small>
                                        </div>
                                        <small class="text-muted"><i class="material-symbols-outlined align-middle fs-6">visibility</i> @item.view_count</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <img src="https://cdn-icons-png.flaticon.com/512/7486/7486744.png" width="100" class="opacity-50 mb-3" />
                    <p class="text-muted">Chưa có bài viết nào trong mục này.</p>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="sticky-top" style="top: 100px;">
                <div class="bg-white p-4 rounded-3 shadow-sm border mb-4">
                    <h5 class="fw-bold mb-3">Tìm kiếm bài viết</h5>
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Bạn muốn tìm gì...">
                        <button class="btn btn-primary-custom text-white"><i class="material-symbols-outlined align-middle">search</i></button>
                    </div>
                </div>

                <div class="bg-white p-4 rounded-3 shadow-sm border">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">Chuyên mục</h5>
                    <div class="d-flex flex-column gap-1">
                        <a href="@Url.Action("Index", "Blog")" class="sidebar-link @(ViewBag.CurrentCategory == null ? "fw-bold text-primary-custom" : "")">
                            Tất cả bài viết
                        </a>
                        @foreach (var cat in categories)
                        {
                            <a href="@Url.Action("Index", "Blog", new { categoryId = cat.id })" class="sidebar-link">
                                @cat.name <span class="float-end badge bg-light text-muted border rounded-pill">@cat.posts.Count(x => x.status == "PUBLISHED")</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>