@model congnghephanmem.Models.CouponViewModel

@{
    ViewBag.Title = "Tạo Mã Khuyến Mãi Mới";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="chart-box">
            <div class="d-flex align-items-center gap-2 mb-4">
                <a href="@Url.Action("Index")" class="text-decoration-none text-muted">
                    <span class="material-symbols-outlined">arrow_back</span>
                </a>
                <h4 class="fw-bold m-0">Thiết lập mã giảm giá</h4>
            </div>

            @using (Html.BeginForm("Create", "Coupon", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted">Mã Code (Ví dụ: SALE50)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><span class="material-symbols-outlined fs-5">qr_code_2</span></span>
                            @Html.TextBoxFor(m => m.Code, new { @class = "form-control border-start-0 ps-0 text-uppercase fw-bold", placeholder = "Nhập mã..." })
                        </div>
                        @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted">Trạng thái</label>
                        <div class="form-check form-switch mt-2">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", @checked = "checked" })
                            <label class="form-check-label" for="IsActive">Kích hoạt ngay</label>
                        </div>
                    </div>

                    <hr class="text-muted opacity-25 my-4">

                    <h6 class="fw-bold text-primary">Thiết lập điều kiện & Mức giảm</h6>

                    <div class="col-md-12">
                        <label class="form-label fw-bold text-muted">Giá trị đơn hàng tối thiểu (VNĐ)</label>
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.MinOrderValue, new { @class = "form-control", @type = "number", placeholder = "VD: 100000" })
                            <span class="input-group-text">VNĐ</span>
                        </div>
                        <small class="text-muted">Mã chỉ áp dụng khi tổng tiền giỏ hàng lớn hơn mức này.</small>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted">Loại giảm giá</label>
                        @Html.DropDownListFor(m => m.DiscountType, new List<SelectListItem>
                        {
                            new SelectListItem { Text = "Giảm theo số tiền (VNĐ)", Value = "FIXED_AMOUNT" },
                            new SelectListItem { Text = "Giảm theo phần trăm (%)", Value = "PERCENTAGE" }
                        }, new { @class = "form-select", id = "discountTypeSelect" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold text-muted">Mức giảm</label>
                        <div class="input-group">
                            @Html.TextBoxFor(m => m.DiscountAmount, new { @class = "form-control fw-bold text-success", @type = "number", placeholder = "Nhập số tiền hoặc %" })
                            <span class="input-group-text" id="discountSuffix">VNĐ</span>
                        </div>
                    </div>

                    <div class="col-12 mt-4 text-end">
                        <button type="submit" class="btn btn-primary px-4 py-2 fw-bold" style="background-color: var(--admin-primary); border: none;">
                            <span class="material-symbols-outlined align-middle fs-6">save</span> Lưu mã giảm giá
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script>
    document.getElementById('discountTypeSelect').addEventListener('change', function () {
        var suffix = document.getElementById('discountSuffix');
        if (this.value === 'PERCENTAGE') {
            suffix.innerText = '%';
        } else {
            suffix.innerText = 'VNĐ';
        }
    });
</script>