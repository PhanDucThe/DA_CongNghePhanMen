@model congnghephanmem.ViewModels.CheckoutViewModel

@{
    ViewBag.Title = "Thanh toán";
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
}

<style>
    .step-circle {
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 12px;
        font-weight: bold;
    }

    .bg-step-active {
        background-color: var(--primary-color);
        color: #111;
    }

    .bg-step-inactive {
        background-color: #e9ecef;
        color: #6c757d;
    }

    .text-step-active {
        color: var(--primary-color);
        font-weight: 700;
    }

    /* Radio Box Selection */
    .radio-box {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 15px;
        cursor: pointer;
        transition: all 0.2s;
    }
        /* Khi radio được chọn (dùng selector :has của CSS hiện đại hoặc JS) */
        .radio-box input:checked + label {
            color: var(--primary-color);
            font-weight: bold;
        }

        .radio-box:has(input:checked) {
            border-color: var(--primary-color);
            background-color: rgba(19, 236, 200, 0.05);
            box-shadow: 0 0 0 2px rgba(19, 236, 200, 0.2);
        }

    .checkout-summary {
        position: sticky;
        top: 100px;
    }
</style>

<div class="bg-white border-bottom py-3 sticky-top" style="top: 60px; z-index: 90;">
    <div class="container d-flex justify-content-between align-items-center">
        <h5 class="m-0 fw-bold d-none d-md-block">Nhà Thuốc Online</h5>

        <div class="d-flex align-items-center gap-3 text-sm mx-auto mx-md-0">
            <div class="d-flex align-items-center gap-2 text-muted">
                <span class="step-circle bg-step-inactive">1</span>
                <span>Giỏ hàng</span>
            </div>
            <span class="text-muted">></span>
            <div class="d-flex align-items-center gap-2">
                <span class="step-circle bg-step-active">2</span>
                <span class="text-step-active">Thanh toán</span>
            </div>
            <span class="text-muted">></span>
            <div class="d-flex align-items-center gap-2 text-muted">
                <span class="step-circle bg-step-inactive">3</span>
                <span>Hoàn tất</span>
            </div>
        </div>
    </div>
</div>

<div class="container py-4">
    <h2 class="fw-bold mb-4">Thanh Toán</h2>

    @using (Html.BeginForm("ProcessOrder", "Checkout", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="row g-5">

            <div class="col-lg-7">

                <div class="bg-white p-4 rounded-3 shadow-sm mb-4">
                    <h5 class="fw-bold mb-3">Thông tin nhận hàng</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Họ và tên</label>
                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Nhập họ tên" })
                            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Số điện thoại</label>
                            @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "Nhập số điện thoại" })
                            @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-12">
                            <label class="form-label text-muted small fw-bold">Địa chỉ giao hàng</label>
                            @Html.TextBoxFor(m => m.Address, new { @class = "form-control", placeholder = "Số nhà, đường, phường/xã..." })
                            @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-12">
                            <label class="form-label text-muted small fw-bold">Ghi chú</label>
                            @Html.TextAreaFor(m => m.Note, new { @class = "form-control", rows = "3", placeholder = "Lời nhắn cho shipper..." })
                        </div>
                    </div>
                </div>

                <div class="bg-white p-4 rounded-3 shadow-sm mb-4">
                    <h5 class="fw-bold mb-3">Phương thức vận chuyển</h5>
                    <div class="d-flex flex-column gap-3">
                        <label class="radio-box d-flex align-items-center">
                            @Html.RadioButtonFor(m => m.ShippingMethod, "STANDARD", new { @checked = "checked", @class = "form-check-input me-3" })
                            <div class="flex-grow-1">
                                <span class="fw-bold d-block">Giao tiêu chuẩn (2-3 ngày)</span>
                            </div>
                            <span class="fw-bold">20.000đ</span>
                        </label>

                        <label class="radio-box d-flex align-items-center">
                            @Html.RadioButtonFor(m => m.ShippingMethod, "EXPRESS", new { @class = "form-check-input me-3" })
                            <div class="flex-grow-1">
                                <span class="fw-bold d-block">Giao hỏa tốc 2h</span>
                            </div>
                            <span class="fw-bold">40.000đ</span>
                        </label>
                    </div>
                </div>

                <div class="bg-white p-4 rounded-3 shadow-sm mb-4">
                    <h5 class="fw-bold mb-3">Phương thức thanh toán</h5>
                    <div class="d-flex flex-column gap-3">
                        <label class="radio-box d-flex align-items-center">
                            @Html.RadioButtonFor(m => m.PaymentMethod, "COD", new { @checked = "checked", @class = "form-check-input me-3" })
                            <span class="material-symbols-outlined me-2 text-primary-custom">local_shipping</span>
                            <span>Thanh toán khi nhận hàng (COD)</span>
                        </label>

                        <label class="radio-box d-flex align-items-center">
                            @Html.RadioButtonFor(m => m.PaymentMethod, "BANK", new { @class = "form-check-input me-3" })
                            <span class="material-symbols-outlined me-2 text-primary-custom">account_balance</span>
                            <span>Chuyển khoản ngân hàng</span>
                        </label>

                        <label class="radio-box d-flex align-items-center">
                            @Html.RadioButtonFor(m => m.PaymentMethod, "MOMO", new { @class = "form-check-input me-3" })
                            <span class="material-symbols-outlined me-2 text-primary-custom">account_balance_wallet</span>
                            <span>Ví MoMo / ZaloPay</span>
                        </label>
                    </div>
                </div>

            </div>

            <div class="col-lg-5">
                <div class="bg-white p-4 rounded-3 shadow-sm checkout-summary">
                    <h5 class="fw-bold mb-4">Đơn hàng của bạn</h5>

                    <div class="d-flex flex-column gap-3 mb-4 overflow-auto" style="max-height: 300px;">
                        @foreach (var item in Model.CartItems)
                        {
                            <div class="d-flex align-items-center gap-3 border-bottom pb-3">
                                <img src="@item.ProductImage" class="rounded border" style="width: 60px; height: 60px; object-fit: cover;">
                                <div class="flex-grow-1">
                                    <h6 class="mb-0 text-truncate" style="max-width: 200px;">@item.ProductName</h6>
                                    <small class="text-muted">SL: @item.Quantity</small>
                                </div>
                                <span class="fw-bold text-dark">@string.Format("{0:0,0}đ", item.Total)</span>
                            </div>
                        }
                    </div>

                    <div class="border-top pt-3">
                        <div class="d-flex justify-content-between mb-2 text-muted">
                            <span>Tạm tính</span>
                            <span>@string.Format("{0:0,0}đ", Model.SubTotal)</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 text-muted">
                            <span>Phí vận chuyển</span>
                            <span id="shippingFeeDisplay">@string.Format("{0:0,0}đ", Model.ShippingFee)</span>
                        </div>
                        <div class="d-flex justify-content-between mt-3 pt-3 border-top align-items-center">
                            <span class="fw-bold fs-5">Tổng cộng</span>
                            <span class="fw-bold fs-4 text-danger" id="totalAmountDisplay">@string.Format("{0:0,0}đ", Model.TotalAmount)</span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary-custom w-100 py-3 rounded-3 fw-bold mt-4 shadow-sm text-uppercase">
                        Đặt Hàng
                    </button>

                    <div class="mt-3 text-center small text-muted d-flex justify-content-center gap-3">
                        <span><i class="material-symbols-outlined align-middle fs-6 text-success">verified_user</i> Bảo mật SSL</span>
                        <span><i class="material-symbols-outlined align-middle fs-6 text-success">published_with_changes</i> Đổi trả 7 ngày</span>
                    </div>
                </div>
            </div>

        </div>
    }
</div>

<script>
    const radioButtons = document.querySelectorAll('input[name="ShippingMethod"]');
    const shippingFeeDisplay = document.getElementById('shippingFeeDisplay');
    const totalAmountDisplay = document.getElementById('totalAmountDisplay');

    // Lấy giá trị subtotal từ server (ẩn trong code Razor)
    const subTotal = @Model.SubTotal;

    radioButtons.forEach(radio => {
        radio.addEventListener('change', function() {
            let fee = 20000; // Mặc định Standard
            if (this.value === 'EXPRESS') {
                fee = 40000;
            }

            // Format tiền tệ VNĐ
            shippingFeeDisplay.innerText = fee.toLocaleString('vi-VN') + 'đ';
            totalAmountDisplay.innerText = (subTotal + fee).toLocaleString('vi-VN') + 'đ';
        });
    });
</script>